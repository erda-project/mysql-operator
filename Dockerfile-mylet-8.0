ARG TARGETARCH=amd64
FROM registry.erda.cloud/k4s/$TARGETARCH/golang:1.17-buster AS builder

WORKDIR /workspace

COPY api/ api/
COPY controllers/ controllers/
COPY pkg/ pkg/
COPY cmd/ cmd/
COPY go.mod go.mod
COPY go.sum go.sum
RUN GOPROXY=https://goproxy.cn,direct CGO_ENABLED=0 GOOS=linux go build -a -o mylet ./cmd/mylet/

FROM registry.erda.cloud/k4s/percona-xtrabackup:8.0.35 AS xtrabackup

FROM registry.erda.cloud/k4s/mysql:8.0.40

RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
  echo Asia/Shanghai > /etc/timezone

WORKDIR /
COPY --from=builder /workspace/mylet .
COPY --from=xtrabackup /lib64/libprocps.so.8* /lib64/
COPY --from=xtrabackup /usr/lib/private /usr/lib/private
COPY --from=xtrabackup /usr/bin/xtrabackup /usr/bin/xtrabackup
RUN ldconfig
VOLUME /mydir
EXPOSE 3306 33080
USER mysql:mysql
ENTRYPOINT []
CMD ["/mylet"]
